# MONEYY Supabase Configuration
# Replace with your actual Supabase project settings from:
# Project Settings -> API in your Supabase Dashboard

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon / Publishable Key
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Supabase Service Role / Secret Key (Server-side ONLY - never expose to browser or Git)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Flask Secret Key for secure session cookies
FLASK_SECRET_KEY=change-this-to-a-random-secret-key-in-production
